# ================================================================
# XCodec — Variables de entorno
# ================================================================
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commitear .env.local — está en .gitignore.
# ================================================================


# ── Supabase ────────────────────────────────────────────────────
# Obtener en: supabase.com → tu proyecto → Settings → API

# URL del proyecto (expuesta al cliente — seguro)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anon (expuesta al cliente — seguro para Realtime read-only)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave service_role — SOLO SERVIDOR — NUNCA exponer al cliente
# Bypasa todas las políticas de seguridad de Supabase.
# Usada exclusivamente en Server Actions y Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Sesiones ────────────────────────────────────────────────────
# Secreto para cifrar las cookies iron-session (AES-256-CBC).
# Requisitos: mínimo 32 caracteres, aleatorio, sin patrones.
#
# Generar un secreto seguro con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NUNCA reutilizar el mismo secreto en distintos entornos.
# Cambiar este valor invalida todas las sesiones activas.
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria_de_minimo_32_caracteres


# ── App ─────────────────────────────────────────────────────────
# URL pública de la aplicación (sin barra final).
# Usado para construir URLs absolutas si fuera necesario en el futuro.
NEXT_PUBLIC_APP_URL=http://localhost:3000
